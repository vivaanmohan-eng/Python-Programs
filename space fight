import pygame
from time import*
pygame.font.init()
pygame.mixer.init()

WIDTH = 800
HEIGHT = 500
screen = pygame.display.set_mode((WIDTH,HEIGHT))
title = pygame.display.set_caption("Space Fighting")
WHITE = (255,255,255)
RED = (255,0,0)
YELLOW = (255,255,0)
BLACK = (0,0,0)

border = pygame.Rect(WIDTH/2-25,0,50,HEIGHT)

boom = pygame.mixer.Sound("Space_Fighting\Assets\\boom.mp3")
pew = pygame.mixer.Sound("Space_Fighting\Assets\pew.mp3")
hp = pygame.font.SysFont("comicsans",50)
winner_font = pygame.font.SysFont("comicsans",90)
fps = 60

vel = 5
bullet_vel = 7
max_bullets = 5
spaceship_width = 50
spaceship_height = 40

yellow_hit = pygame.USEREVENT + 1
red_hit = pygame.USEREVENT + 2
yellow_ship = pygame.image.load("Space_Fighting\Assets\p2.png")
red_ship = pygame.image.load("Space_Fighting\Assets\p1.png")

red_spaceship = pygame.transform.rotate(pygame.transform.scale(red_ship,(spaceship_width,spaceship_height)),90)
yellow_spaceship = pygame.transform.rotate(pygame.transform.scale(yellow_ship,(spaceship_width,spaceship_height)),270)

space = pygame.transform.scale(pygame.image.load("Space_Fighting\Assets\\bg.png"),(WIDTH,HEIGHT))

def draw_window(red,yellow,red_bullets,yellow_bullets,red_hp,yellow_hp):
    screen.blit(space,(0,0))
    pygame.draw.rect(screen,BLACK,border)

    red_health_text = hp.render("HEALTH: " + str(red_hp),1,WHITE)
    yellow_health_text = hp.render("HEALTH: " + str(yellow_hp),1,WHITE)

    screen.blit(red_health_text,(WIDTH-red_health_text.get_width()-10,10))
    screen.blit(yellow_health_text,(10,10))

    for bullet in red_bullets:
        pygame.draw.rect(screen,RED,bullet)

    for bullet in yellow_bullets:
        pygame.draw.rect(screen,YELLOW,bullet)
    pygame.display.update()

#Control yellow ship
def yellow_handle_movement(key_pressed,yellow):
    if key_pressed(pygame.K_a) and yellow.x > 0:
        yellow.x -= vel
    if key_pressed(pygame.K_d) and yellow.x+yellow.width < border.x:
        yellow.x += vel
    if key_pressed(pygame.K_w) and yellow.y > 0:
        yellow.y -= vel
    if key_pressed(pygame.K_s) and yellow.y+yellow.height < 500-15:
        yellow.y += vel

def red_handle_movement(key_pressed,red):
    if key_pressed(pygame.K_LEFT) and red.x > border.x+border.width:
        red.x -= vel
    if key_pressed(pygame.K_RIGHT) and red.x+red.width < 800:
        red.x += vel
    if key_pressed(pygame.K_UP) and red.y > 0:
        red.y -= vel
    if key_pressed(pygame.K_DOWN) and red.y+red.height < 500-15:
        red.y += vel

def handle_bullets(yellow_bullets,red_bullets,yellow,red):
    for bullet in yellow_bullets:
        bullet.x += bullet_vel
        if red.colliderect(bullet):
            pygame.event.post(pygame.event.Event(red_hit))
            yellow_bullets.remove(bullet)
        elif bullet.x > 800:
            yellow_bullets.remove(bullet)

    for bullet in red_bullets:
        bullet.x -= bullet_vel
        if yellow.colliderect(bullet):
            pygame.event.post(pygame.event.Event(yellow_hit))
            red_bullets.remove(bullet)
        elif bullet.x < 0:
            red_bullets.remove(bullet)
            

def draw_winner(text):
    draw_text = winner_font.render(text,1,WHITE)
    screen.blit(draw_text,(WIDTH/2-draw_text.getwidth()/2,
                           HEIGHT/2-draw_text.getheight()/2))
    pygame.display.update()
    pygame.time.display(5000)

def main():
    red = pygame.Rect(600,100,spaceship_width,spaceship_height)
    yellow = pygame.Rect(200,100,spaceship_width,spaceship_height)
    red_bullets = []
    yellow_bullets = []
    red_hp = 100
    yellow_hp = 100
    clock = pygame.time.Clock()
    running = True
    while running:
        clock.tick(fps)
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
            if event.type == pygame.KEYDOWN:
                if event.type == pygame.K_LCTRL and len(yellow_bullets) < max_bullets:
                    bullet = pygame.Rect(yellow.x+yellow.width,
                                         yellow.y+yellow.height//2-2,
                                         20,15)
                    yellow_bullets.append(bullet)
                    pew.play()
                
                if event.type == pygame.K_RCTRL and len(red_bullets)<max_bullets:
                    bullet=pygame.Rect(red.x,
                                       red.y+red.height/2-2,15,15)
                    red_bullets.append(bullet)
                    pew.play()
            
            if event.type == red_hit:
                red_hp -= 10
                boom.play()
            if event.type == yellow_hit:
                yellow_hp -= 10
                boom.play()

        winner_text = ""
        if red_hp <= 0:
            winner_text = "Yellow wins!"
        if yellow_hp <= 0:
            winner_text = "Red wins!"
        if winner_text != "":
            draw_winner(winner_text)
            break

        keys_pressed = pygame.key.get_pressed()
        yellow_handle_movement(keys_pressed,yellow)
        red_handle_movement(keys_pressed,red)

        draw_window(red,yellow,red_bullets,yellow_bullets,red_hp,yellow_hp)
    main()

if __name__ == "__main__":
    main()
