import pygame
pygame.init()
import random as ran
WIDTH = 800
HEIGHT= 500
screen = pygame.display.set_mode((WIDTH,HEIGHT))
title = pygame.display.set_caption("Flappy bird")
screen.fill((255,255,255))
pygame.display.update()
font = pygame.font.SysFont("Arial",30)
FPS = 60


bg = pygame.image.load("flappy bird\image\\bg.png")
ground = pygame.image.load("flappy bird\image\ground.png")
restart = pygame.image.load("flappy bird\image\\restart.png")

ground_scroll = 0
scroll_speed = 10
flying = False
game_over = False
pipe_gap = 150
pipe_freq = 2000
last_pipe = pygame.time.get_ticks()-pipe_freq
score = 0
passed_pipe = False


def draw_text(text,font,color,x,y):
    screen.blit(font.render(text,True,"Black"),(x,y))
    

def reset_game():
    pipe_group.empty()
    flappy.rect.center=(100,HEIGHT/2)
    global score
    global passed_pipe
    score = 0
    passed_pipe = False
    return score

class Bird(pygame.sprite.Sprite):
    def __init__(self,x,y):
        pygame.sprite.Sprite.__init__(self)
        self.images = [pygame.image.load(f"flappy bird\image\\bird{i}.png")
                       for i in range(1,4)]
        self.index = 0
        self.counter = 0
        self.image = self.images[self.index]
        self.rect = self.image.get_rect(center = (x,y))
        self.velocity = 0
        self.clicked = False

    def update(self):
        if flying:
            self.velocity = min(self.velocity+0.5,8)
            self.rect.y += int(self.velocity)
        if not game_over:
            if pygame.mouse.get_pressed()[0] and not self.clicked:
                self.clicked = True
                self.velocity = -10
        
            if not pygame.mouse.get_pressed()[0]:
                self.clicked = False
        
            self.counter += 1
            if self.counter > 5:
                self.counter = 0
                self.index = (self.index + 1)%len(self.images)
        
            self.image = pygame.transform.rotate(self.images[self.index],self.velocity * -2)

        else:
            self.image = pygame.transform.rotate(self.images[self.index],-90)

#Showing pipes and checking for collision
class Pipe(pygame.sprite.Sprite):
    def __init__(self,x,y,pos):
        pygame.sprite.Sprite.__init__(self)
        self.image = pygame.image.load("flappy bird\image\pipe.png")
        if pos == 1: #top pipe
            self.image = pygame.transform.flip(self.image,False,True)
            self.rect = self.image.get_rect(bottomleft = 
                                            (x,y-pipe_gap//2))
        else: #bottom pipe
            self.rect = self.image.get_rect(topleft =
                                            (x,y+pipe_gap//2))

    def update(self):
        self.rect.x -= scroll_speed
        if self.rect.right < 0:
            self.kill()


class Button():
    def __init__(self,x,y,image):
        self.image = image
        self.rect = self.image.get_rect(topleft = (x,y))
    
    def draw(self):
        pos = pygame.mouse.get_pos()
        if self.rect.collidepoint(pos) and pygame.mouse.get_pressed()[0]:
            return True
        screen.blit(self.image,self.rect)
        return False


bird_group = pygame.sprite.Group()
pipe_group = pygame.sprite.Group()

#Creating objects

flappy = Bird(100,HEIGHT/2)
bird_group.add(flappy)
restart_button = Button(WIDTH//2-50,HEIGHT//2-100,restart)

clock = pygame.time.Clock()
running = True
while running:
    clock.tick(FPS)
    screen.blit(bg,(0,0))
    if not game_over and flying:
        time_now = pygame.time.get_ticks()
        if time_now - last_pipe > pipe_freq:
            pipe_height = ran.randint(-100,100)
            Pipe(WIDTH,HEIGHT//2+pipe_height,-1).add(pipe_group) #bottom pipe
            Pipe(WIDTH,HEIGHT//2+pipe_height,1).add(pipe_group) #top pipe
            last_pipe = time_now
        ground_scroll = (ground_scroll-scroll_speed)%35
        pipe_group.update()

    screen.blit(ground,(ground_scroll,450))

    bird_group.update()
    bird_group.draw(screen)
    pipe_group.draw(screen)
    draw_text(str(score),font,(0,0,0),WIDTH/2,50)

    if (pipe_group) \
        and (flappy.rect.right < pipe_group.sprites()[0].rect.right)\
        and (flappy.rect.left > pipe_group.sprites()[0].rect.left)\
        and (not passed_pipe):


        passed_pipe = True

    if (passed_pipe and pipe_group) \
        and (flappy.rect.left > pipe_group.sprites()[0].rect.right):
        score += 1
        passed_pipe = False
    #collision detection
    if pygame.sprite.groupcollide(bird_group,pipe_group,False,False) \
        or (flappy.rect.top < 0 ) or flappy.rect.bottom >= 480:
        game_over = True
        flying = False

    if game_over:
        if restart_button.draw():
            reset_game()
            game_over = False

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()

        if event.type == pygame.MOUSEBUTTONDOWN and not flying and not game_over:
            flying = True
    
    pygame.display.update()

pygame.quit()
