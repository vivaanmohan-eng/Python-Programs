import tkinter as tk

def convert():
    miles = float(entry.get())
    kilometres = miles * 1.60934
    result.config(text=f"{kilometres} kilometres")

window = tk.Tk()
window.title("Distance Converter")
window.geometry("300x200")

label = tk.Label(window, text="Enter Miles:")
label.place(x=30, y=30)

entry = tk.Entry(window)
entry.place(x=120, y=30)

button = tk.Button(window, text="Convert", command=convert)
button.place(x=110, y=75)

result = tk.Label(window, text="")
result.place(x=80, y=125)

window.mainloop()
