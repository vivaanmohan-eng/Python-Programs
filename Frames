from tkinter import *
root = Tk()
root.title("Frame")
root.geometry("500x500")

w = Label(root, text = "Chocos and Icecream", font=50,bg = "Red")
w.pack()

#creating two frames
frame1 = Frame(root,bg = "Brown",borderwidth=7)
frame1.pack(pady=20)

frame2 = Frame(root,bg = "Blue",borderwidth=7)
frame2.pack(side = BOTTOM)

b1 = Button(frame1,text="Choco")
b2 = Button(frame1,text = "White Choco")
b3 = Button(frame1,text = "Dark Choco")
b1.pack(side = LEFT)
b2.pack(side = LEFT)
b3.pack(side=LEFT)

i1 = Button(frame2, text="Chocolate")
i1.pack(side = TOP)
i2 = Button(frame2, text="Vanilla")
i2.pack(side = TOP)
i2 = Button(frame2, text="Strawberry")
i2.pack(side = TOP)





root.mainloop()
